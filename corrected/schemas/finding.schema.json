{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roundtable.local/schemas/finding.schema.json",
  "title": "CodeFinding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fingerprint", "scanId", "analyzer", "ruleId", "severity", "confidence", "status", "message", "firstSeenCommit", "lastSeenCommit"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scanId": {"type": "string", "format": "uuid"},
    "analyzer": {"type": "object", "additionalProperties": false, "required": ["id", "version", "configHash"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "configHash": {"type": "string"}}},
    "ruleId": {"type": "string"},
    "category": {"type": "string"},
    "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
    "confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "status": {"enum": ["open", "acknowledged", "suppressed", "fixed", "stale", "unknown"]},
    "baselineStatus": {"enum": ["new", "existing", "worsened", "improved", "unknown"]},
    "location": {"type": ["object", "null"], "additionalProperties": false, "properties": {"path": {"type": "string"}, "startLine": {"type": "integer", "minimum": 1}, "startColumn": {"type": "integer", "minimum": 1}, "endLine": {"type": "integer", "minimum": 1}, "endColumn": {"type": "integer", "minimum": 1}}},
    "symbol": {"type": ["string", "null"]},
    "message": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "suggestedAction": {"type": ["string", "null"]},
    "firstSeenCommit": {"type": "string"},
    "lastSeenCommit": {"type": "string"},
    "suppression": {"type": ["object", "null"], "additionalProperties": false, "required": ["reason"], "properties": {"reason": {"type": "string", "minLength": 1}, "expiresAt": {"type": ["string", "null"], "format": "date-time"}}}
  }
}
